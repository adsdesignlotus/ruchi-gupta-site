{
  "name": "ruchi-gupta-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "18.x"
  },
  "scripts": {
    "clean": "rm -rf dist node_modules/.cache .astro",
    "reinstall": "rm -rf node_modules dist .astro package-lock.json && npm install",
    "dev": "astro dev",
    "dev:clean": "npm run clean && astro dev",
    "build": "astro build",
    "preview": "npx --yes vercel dev",
    "astro": "astro",
    "check": "npm run build",
    "check:full": "npm run clean && npm run check"
  },
  "dependencies": {
    "@astrojs/react": "^3.6.3",
    "@astrojs/tailwind": "^5.1.4",
    "@astrojs/vercel": "^7.8.2",
    "astro": "^4.16.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5"
  }
}
