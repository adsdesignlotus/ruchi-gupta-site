---
import { navItems, site } from "@/lib/site";

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;

function isActive(href: string): boolean {
  const p = pathname.replace(/\/$/, "") || "/";
  const h = href.replace(/\/$/, "") || "/";
  if (h === "/") return p === "/";
  return p === h || p.startsWith(h + "/");
}
---

<nav
  class="sticky top-0 z-50 border-b border-black/[0.06] bg-background/85 backdrop-blur-md"
  role="navigation"
  aria-label="Main"
>
  <div
    class="mx-auto max-w-content px-page-mobile md:px-page-tablet lg:px-page-desktop"
  >
    <div
      class="flex h-14 min-w-0 items-center justify-between gap-2 md:h-16 md:gap-4"
    >
      <a
        class="hover-brightness flex min-w-0 shrink items-end gap-0.5 font-serif text-lg font-semibold tracking-heading text-text-primary transition-colors hover:text-accent sm:gap-1 md:text-xl"
        href="/"
      >
        <span
          class="relative flex h-12 w-12 shrink-0 items-center justify-center md:h-14 md:w-14"
          style="mask-image:url(/watermark.png);-webkit-mask-image:url(/watermark.png);mask-size:contain;-webkit-mask-size:contain;mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;background-color:var(--color-primary)"
        />
        <span
          class="flex h-12 min-w-0 items-center font-serif text-[clamp(1.25rem,4.2vw+0.6rem,2.125rem)] font-medium leading-none tracking-heading md:h-14"
        >
          {site.name}
        </span>
      </a>
      <ul class="hidden items-center gap-6 md:flex lg:gap-8">
        {
          navItems.map(({ href, label }) => (
            <li>
              <a
                class:list={[
                  "text-sm transition-colors hover:text-accent",
                  isActive(href)
                    ? "font-semibold text-text-primary"
                    : "text-text-secondary",
                ]}
                href={href}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
      <button
        type="button"
        id="event-nav-menu-btn"
        class="-mr-2 p-2 text-text-primary transition-colors hover:text-accent md:hidden"
        aria-expanded="false"
        aria-controls="event-mobile-menu"
      >
        <span class="sr-only">Open menu</span>
        <svg
          class="h-6 w-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
    <div
      id="event-mobile-menu"
      class="overflow-hidden border-t border-black/[0.06] transition-all duration-200 md:hidden max-h-0 opacity-0"
      hidden
    >
      <ul class="flex flex-col gap-1 py-4">
        <li>
          <a
            class:list={[
              "block py-2 transition-colors hover:text-accent",
              (pathname.replace(/\/$/, "") || "/") === "/"
                ? "font-semibold text-text-primary"
                : "text-text-secondary",
            ]}
            href="/"
          >
            Home
          </a>
        </li>
        {
          navItems.map(({ href, label }) => (
            <li>
              <a
                class:list={[
                  "block py-2 transition-colors hover:text-accent",
                  isActive(href)
                    ? "font-semibold text-text-primary"
                    : "text-text-secondary",
                ]}
                href={href}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</nav>

<script>
  (function () {
    const btn = document.getElementById("event-nav-menu-btn");
    const menu = document.getElementById("event-mobile-menu");
    if (!btn || !menu) return;
    btn.addEventListener("click", () => {
      const open = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", open ? "false" : "true");
      if (open) {
        menu.classList.add("max-h-0", "opacity-0");
        menu.classList.remove("max-h-80", "opacity-100");
        menu.hidden = true;
      } else {
        menu.hidden = false;
        menu.classList.remove("max-h-0", "opacity-0");
        menu.classList.add("max-h-80", "opacity-100");
      }
    });
  })();
</script>
