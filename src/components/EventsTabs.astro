---
import { cloudinaryImageUrl, getCloudinaryCloudName } from "@/lib/cloudinary";
import { upcomingEventsList } from "@/lib/events";
import { isValidHtmlDateTime } from "@/lib/html-datetime";
import { pastEventsList } from "@/lib/past-events";
import { workshopsList } from "@/lib/workshops";

const cloudName = getCloudinaryCloudName();

const tabBtnBase =
  "rounded-t-card border-b-2 px-4 py-3 text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-accent/40";
const tabBtnSelected = "border-accent text-text-primary";
const tabBtnIdle =
  "border-transparent text-text-secondary hover:text-accent";

function cloudinaryThumb(publicId: string): string | null {
  if (!cloudName) return null;
  return cloudinaryImageUrl(cloudName, publicId, 1600);
}

function pastCardSrc(ev: (typeof pastEventsList)[number]): string | null {
  if (ev.inviteLocalSrc) return ev.inviteLocalSrc;
  if (cloudName && ev.invitePublicId) {
    return cloudinaryThumb(ev.invitePublicId);
  }
  return null;
}

function workshopCardSrc(ev: (typeof workshopsList)[number]): string | null {
  if (ev.coverSrc) return ev.coverSrc;
  if (cloudName && ev.coverPublicId) {
    return cloudinaryThumb(ev.coverPublicId);
  }
  return null;
}

const eventCardImageWrap =
  "hover-zoom relative h-36 w-full overflow-hidden bg-fill sm:h-40 md:h-44";
/** Match performance cards: cover fill, crop from bottom, keep heads near top. */
const eventCardImgClass =
  "pointer-events-none absolute inset-0 h-full w-full object-cover object-top";
const eventCardBody =
  "flex flex-1 flex-col p-4 md:p-5";
const eventCardCta =
  "hover-brightness mt-3 inline-flex w-fit items-center justify-center rounded-card bg-primary py-2.5 px-4 text-sm font-semibold text-white shadow-card transition hover:bg-primary-hover sm:mt-4";
---

<div id="events-hub-tabs" class="events-hub-tabs">
  <div
    class="mb-10 border-b border-black/[0.06]"
    role="tablist"
    aria-label="Event categories"
  >
    <div class="-mb-px flex flex-wrap gap-1">
      <button
        type="button"
        role="tab"
        aria-selected="true"
        data-events-tab="Upcoming"
        id="tab-upcoming"
        class:list={[tabBtnBase, tabBtnSelected]}
      >
        Upcoming
      </button>
      <button
        type="button"
        role="tab"
        aria-selected="false"
        data-events-tab="Past"
        id="tab-past"
        class:list={[tabBtnBase, tabBtnIdle]}
      >
        Past
      </button>
      <button
        type="button"
        role="tab"
        aria-selected="false"
        data-events-tab="Workshop"
        id="tab-workshop"
        class:list={[tabBtnBase, tabBtnIdle]}
      >
        Workshop
      </button>
    </div>
  </div>

  <div
    role="tabpanel"
    id="panel-upcoming"
    aria-labelledby="tab-upcoming"
    data-events-panel="Upcoming"
  >
    <div class="grid min-w-0 grid-cols-1 gap-5 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3 lg:gap-6 xl:grid-cols-4 xl:gap-6">
      {
        upcomingEventsList.map((ev) => (
          <a
            href={`/events/${ev.slug}`}
            class="card-elevated flex min-w-0 flex-col no-underline text-inherit outline-none transition-colors focus-visible:ring-2 focus-visible:ring-accent/40 focus-visible:ring-offset-2"
            data-visibility="public"
          >
            <div class:list={[eventCardImageWrap]}>
              <div class="absolute inset-0 bg-fill">
                <img
                  src={ev.coverSrc}
                  alt={ev.coverAlt}
                  sizes="(max-width: 1024px) 100vw, 400px"
                  loading="lazy"
                  decoding="async"
                  class={eventCardImgClass}
                />
              </div>
            </div>
            <div class:list={[eventCardBody]}>
              <p class="mb-1.5 text-xs leading-snug text-text-secondary">
                {isValidHtmlDateTime(ev.whenIso) ? (
                  <time class="tabular-nums" datetime={ev.whenIso}>{ev.when}</time>
                ) : (
                  <span class="tabular-nums">{ev.when}</span>
                )}
                <span class="mx-1.5 text-text-secondary/45" aria-hidden="true">·</span>
                <span class="break-words">{ev.city}</span>
              </p>
              <h3 class="break-words font-serif text-subsection-title font-semibold leading-snug tracking-heading text-text-primary">
                {ev.title}
              </h3>
              <p class="mt-1.5 flex-1 line-clamp-2 text-sm leading-snug text-text-secondary">
                {ev.summary}
              </p>
              <span class:list={[eventCardCta]}>View details</span>
            </div>
          </a>
        ))
      }
    </div>
  </div>

  <div
    role="tabpanel"
    id="panel-past"
    aria-labelledby="tab-past"
    data-events-panel="Past"
    hidden
  >
    <div class="grid min-w-0 grid-cols-1 gap-5 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3 lg:gap-6 xl:grid-cols-4 xl:gap-6">
      {
        pastEventsList.map((ev) => {
          const imgSrc = pastCardSrc(ev);
          return (
            <a
              href={`/events/${ev.slug}`}
              class="card-elevated flex min-w-0 flex-col no-underline text-inherit outline-none transition-colors focus-visible:ring-2 focus-visible:ring-accent/40 focus-visible:ring-offset-2"
            >
              <div class:list={[eventCardImageWrap]}>
                {imgSrc ? (
                  <div class="absolute inset-0 bg-fill">
                    <img
                      src={imgSrc}
                      alt={`Invitation — ${ev.title}`}
                      sizes="(max-width: 1024px) 100vw, 400px"
                      loading="lazy"
                      decoding="async"
                      class={eventCardImgClass}
                    />
                  </div>
                ) : (
                  <div class="absolute inset-0 flex items-center justify-center bg-fill px-4 text-center text-xs text-text-secondary">
                    Add{" "}
                    <code class="mx-1 rounded bg-background px-1">
                      PUBLIC_CLOUDINARY_CLOUD_NAME
                    </code>{" "}
                    or a local image in event data
                  </div>
                )}
              </div>
              <div class:list={[eventCardBody]}>
                <p class="mb-1.5 text-xs leading-snug text-text-secondary">
                  {isValidHtmlDateTime(ev.whenIso) ? (
                    <time class="tabular-nums" datetime={ev.whenIso}>{ev.when}</time>
                  ) : (
                    <span class="tabular-nums">{ev.when}</span>
                  )}
                  <span class="mx-1.5 text-text-secondary/45" aria-hidden="true">·</span>
                  <span class="break-words">{ev.city}</span>
                </p>
                <h3 class="break-words font-serif text-subsection-title font-semibold leading-snug tracking-heading text-text-primary">
                  {ev.title}
                </h3>
                <p class="mt-1.5 flex-1 line-clamp-2 text-sm leading-snug text-text-secondary">
                  {ev.summary}
                </p>
                <span class:list={[eventCardCta]}>View summary & gallery</span>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>

  <div
    role="tabpanel"
    id="panel-workshop"
    aria-labelledby="tab-workshop"
    data-events-panel="Workshop"
    hidden
  >
    {
      workshopsList.length === 0 ? (
        <p class="max-w-reading rounded-card border border-black/[0.06] bg-surface p-card text-left text-sm leading-prose text-text-secondary shadow-card">
          Workshop listings will appear here with dates, photos, and summaries.
          Add entries in{" "}
          <code class="rounded bg-background px-1.5 py-0.5 text-text-primary">
            src/lib/workshops.ts
          </code>{" "}
          when you are ready to publish.
        </p>
      ) : (
        <div class="grid min-w-0 grid-cols-1 gap-5 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3 lg:gap-6 xl:grid-cols-4 xl:gap-6">
          {workshopsList.map((ev) => {
            const imgSrc = workshopCardSrc(ev);
            return (
              <a
                href={`/events/${ev.slug}`}
                class="card-elevated flex min-w-0 flex-col no-underline text-inherit outline-none transition-colors focus-visible:ring-2 focus-visible:ring-accent/40 focus-visible:ring-offset-2"
              >
                <div class:list={[eventCardImageWrap]}>
                  {imgSrc ? (
                    <div class="absolute inset-0 bg-fill">
                      <img
                        src={imgSrc}
                        alt={`${ev.title} — cover`}
                        sizes="(max-width: 1024px) 100vw, 400px"
                        loading="lazy"
                        decoding="async"
                        class={eventCardImgClass}
                      />
                    </div>
                  ) : (
                    <div class="absolute inset-0 flex items-center justify-center bg-fill px-4 text-center text-xs text-text-secondary">
                      Add a cover image in workshop data
                    </div>
                  )}
                </div>
                <div class:list={[eventCardBody]}>
                  <p class="mb-1.5 text-xs leading-snug text-text-secondary">
                    {isValidHtmlDateTime(ev.whenIso) ? (
                      <time class="tabular-nums" datetime={ev.whenIso}>{ev.when}</time>
                    ) : (
                      <span class="tabular-nums">{ev.when}</span>
                    )}
                    <span class="mx-1.5 text-text-secondary/45" aria-hidden="true">·</span>
                    <span class="break-words">{ev.city}</span>
                  </p>
                  <h3 class="break-words font-serif text-subsection-title font-semibold leading-snug tracking-heading text-text-primary">
                    {ev.title}
                  </h3>
                  <p class="mt-1.5 flex-1 line-clamp-2 text-sm leading-snug text-text-secondary">
                    {ev.summary}
                  </p>
                  <span class:list={[eventCardCta]}>View details</span>
                </div>
              </a>
            );
          })}
        </div>
      )
    }
  </div>
</div>

<script is:inline>
  (function () {
    var btnSel =
      "rounded-t-card border-b-2 px-4 py-3 text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-accent/40 border-accent text-text-primary";
    var btnIdle =
      "rounded-t-card border-b-2 px-4 py-3 text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-accent/40 border-transparent text-text-secondary hover:text-accent";

    function bind(root) {
      if (!root) return;

      function activate(key) {
        var buttons = root.querySelectorAll("[data-events-tab]");
        var panels = root.querySelectorAll("[data-events-panel]");
        buttons.forEach(function (btn) {
          var k = btn.getAttribute("data-events-tab");
          var isSel = k === key;
          btn.setAttribute("aria-selected", isSel ? "true" : "false");
          btn.className = isSel ? btnSel : btnIdle;
        });
        panels.forEach(function (panel) {
          var pk = panel.getAttribute("data-events-panel");
          if (pk === key) panel.removeAttribute("hidden");
          else panel.setAttribute("hidden", "");
        });
      }

      if (root._eventsTabHandler) {
        root.removeEventListener("click", root._eventsTabHandler);
      }
      function onClick(e) {
        var t = e.target && e.target.closest("[data-events-tab]");
        if (!t || !root.contains(t)) return;
        var key = t.getAttribute("data-events-tab");
        if (key) activate(key);
      }
      root._eventsTabHandler = onClick;
      root.addEventListener("click", onClick);

      var initial = "Upcoming";
      root.querySelectorAll("[data-events-tab]").forEach(function (btn) {
        if (btn.getAttribute("aria-selected") === "true") {
          var k = btn.getAttribute("data-events-tab");
          if (k) initial = k;
        }
      });
      activate(initial);
    }

    function init() {
      bind(document.getElementById("events-hub-tabs"));
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
    document.addEventListener("astro:page-load", init);
  })();
</script>
