---
import "../styles/globals.css";
import ClientShell from "@/components/ClientShell";

interface Props {
  title?: string;
  description?: string;
  /** When true, slot is not wrapped in `ClientShell` (use for pages that ship their own shell island). */
  omitClientShell?: boolean;
}

const {
  title = "Ruchi Gupta | Bharatanatyam Exponent & Cultural Ambassador",
  description =
    "Ruchi Gupta is a Bharatanatyam artist, graded Doordarshan artist, and Founder of Kirti Natya Niketan. Trained in the Pandanallur and Thanjavur traditions.",
  omitClientShell = false,
} = Astro.props;

const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="en" class="font-sans">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href="/icon.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Lato:wght@400;500;600&family=Playfair+Display:wght@500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex min-h-screen flex-col bg-background text-text-primary">
    <!-- Static markup (not React) so it never depends on island hydration -->
    <div
      class="pointer-events-none fixed inset-0 z-0 overflow-hidden"
      aria-hidden="true"
    >
      <div
        class="js-parallax-watermark absolute inset-0 will-change-transform opacity-[0.04] blur-[0.5px]"
        style="mask-image:url(/watermark.png);-webkit-mask-image:url(/watermark.png);mask-size:contain;-webkit-mask-size:contain;mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat;mask-position:center;-webkit-mask-position:center;background-color:var(--color-primary)"
      />
    </div>
    {
      omitClientShell ? (
        <div class="relative z-10 flex min-h-screen w-full flex-col">
          <slot />
        </div>
      ) : (
        <ClientShell client:load pathname={pathname}>
          <slot />
        </ClientShell>
      )
    }
    <script is:inline>
      (function () {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
          return;
        var wm = document.querySelector(".js-parallax-watermark");
        var heroWrap = document.querySelector(".js-parallax-hero-wrap");
        var ticking = false;
        function tick() {
          ticking = false;
          var y = window.scrollY || 0;
          if (wm) {
            wm.style.transform =
              "translate3d(0," + Math.round(y * 0.052) + "px,0)";
          }
          if (heroWrap) {
            var rect = heroWrap.getBoundingClientRect();
            var vh = window.innerHeight || 1;
            if (rect.bottom > -100 && rect.top < vh + 100) {
              var center = rect.top + rect.height * 0.5;
              var shift = Math.round((vh * 0.5 - center) * 0.045);
              shift = Math.max(-32, Math.min(32, shift));
              heroWrap.style.transform =
                "translate3d(0," + shift + "px,0)";
            } else {
              heroWrap.style.transform = "";
            }
          }
        }
        function onScroll() {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(tick);
          }
        }
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll, { passive: true });
        tick();
      })();
    </script>
  </body>
</html>
