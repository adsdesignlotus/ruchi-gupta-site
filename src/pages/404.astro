---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found | Ruchi Gupta">
  <div class="page-shell text-center">
    <h1 class="font-serif text-display font-medium tracking-heading text-text-primary">
      Page not found
    </h1>
    <p class="mx-auto mt-6 max-w-reading text-base leading-prose text-text-secondary">
      The page you requested does not exist or has moved.
    </p>
    <a
      href="/"
      class="hover-brightness mt-10 inline-flex rounded-card bg-primary px-8 py-3 text-sm font-semibold text-white shadow-card transition hover:bg-primary-hover"
    >
      Back to home
    </a>
  </div>
</BaseLayout>
