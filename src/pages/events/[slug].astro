---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { eventsBySlug } from "@/lib/events";
import { pastEventsBySlug } from "@/lib/past-events";
import { PastEventContent } from "@/components/PastEventContent";
import { UpcomingEventContent } from "@/components/UpcomingEventContent";

export function getStaticPaths() {
  const slugs = [
    ...Object.keys(eventsBySlug),
    ...Object.keys(pastEventsBySlug),
  ];
  return slugs.map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug!;
const past = pastEventsBySlug[slug];
const upcoming = eventsBySlug[slug];
const e = past ?? upcoming;
if (!e) {
  return Astro.redirect("/404");
}
---

<BaseLayout title={e.metaTitle} description={e.description}>
  {
    past ? (
      <PastEventContent client:load event={past} />
    ) : (
      <UpcomingEventContent client:load event={upcoming!} />
    )
  }
</BaseLayout>
