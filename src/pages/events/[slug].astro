---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EventPageClient from "@/components/EventPageClient";
import { eventsBySlug } from "@/lib/events";
import { pastEventsBySlug } from "@/lib/past-events";

export function getStaticPaths() {
  const slugs = [
    ...Object.keys(eventsBySlug),
    ...Object.keys(pastEventsBySlug),
  ];
  return slugs.map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug!;
const past = pastEventsBySlug[slug];
const upcoming = eventsBySlug[slug];
const e = past ?? upcoming;
if (!e) {
  return Astro.redirect("/404");
}

const pathname = Astro.url.pathname;
---

<BaseLayout title={e.metaTitle} description={e.description} omitClientShell>
  <EventPageClient
    client:load
    pathname={pathname}
    past={past}
    upcoming={upcoming}
  />
</BaseLayout>
