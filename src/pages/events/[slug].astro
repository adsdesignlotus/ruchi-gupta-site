---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EventFooter from "@/components/event/EventFooter.astro";
import EventGallery from "@/components/event/EventGallery.astro";
import EventHero from "@/components/event/EventHero.astro";
import EventNav from "@/components/event/EventNav.astro";
import { eventsBySlug } from "@/lib/events";
import { pastEventsBySlug } from "@/lib/past-events";
import { eventsCardImage } from "@/lib/site-images";
import { workshopsBySlug } from "@/lib/workshops";
import { isValidHtmlDateTime } from "@/lib/html-datetime";

export function getStaticPaths() {
  const slugs = [
    ...Object.keys(eventsBySlug),
    ...Object.keys(pastEventsBySlug),
    ...Object.keys(workshopsBySlug),
  ];
  return slugs.map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug!;
const past = pastEventsBySlug[slug];
const upcoming = eventsBySlug[slug];
const workshop = workshopsBySlug[slug];
const e = past ?? upcoming ?? workshop;
if (!e) {
  return Astro.redirect("/404");
}

const pathname = Astro.url.pathname;
const isPast = Boolean(past);
const isWorkshop = Boolean(workshop);
---

<BaseLayout title={e.metaTitle} description={e.description} omitClientShell>
  <div class="relative z-10 flex min-h-screen w-full flex-col bg-background">
    <EventNav pathname={pathname} />
    <main class="min-w-0 flex-1">
      {
        isPast ? (
          <div class="page-shell">
            <a
              href="/events"
              class="mb-8 inline-block text-sm text-text-secondary transition-colors hover:text-accent"
            >
              ← Back to Events
            </a>
            <header class="mb-12 text-center md:mb-16 md:text-left">
              <span class="mb-2 inline-block text-xs font-semibold uppercase tracking-widest text-maroon">
                {past!.badge}
              </span>
              <div class="mb-2 flex flex-wrap justify-center gap-x-4 gap-y-1 text-sm leading-prose text-text-secondary md:justify-start">
                {isValidHtmlDateTime(past!.whenIso) ? (
                  <time datetime={past!.whenIso}>{past!.when}</time>
                ) : (
                  <span>{past!.when}</span>
                )}
                <span>{past!.city}</span>
              </div>
              <h1 class="font-serif text-display font-medium tracking-heading text-text-primary">
                {past!.title}
              </h1>
              <p class="mx-auto mt-5 max-w-reading text-left text-base leading-prose text-text-secondary md:mx-0 md:text-lg">
                {past!.description}
              </p>
            </header>
            <section aria-labelledby="past-summary-heading" class="space-y-section-gap">
              <h2
                id="past-summary-heading"
                class="sr-only font-serif text-content-title font-semibold tracking-heading text-text-primary"
              >
                Event summary
              </h2>
              <p class="max-w-reading text-left text-base leading-prose text-text-secondary md:text-lg">
                {past!.summary}
              </p>
            </section>
            <section
              id="gallery"
              class="mt-12 scroll-mt-24 md:mt-16"
              aria-labelledby="event-gallery-heading"
            >
              <header class="mb-8 md:mb-10">
                <h2
                  id="event-gallery-heading"
                  class="font-serif text-content-title font-semibold tracking-heading text-text-primary"
                >
                  Gallery
                </h2>
              </header>
              <EventGallery slides={[...past!.gallery, ...past!.slideshow]} />
            </section>
          </div>
        ) : isWorkshop ? (
          <div class="page-shell">
            <a
              href="/events"
              class="mb-8 inline-block text-sm text-text-secondary transition-colors hover:text-accent"
            >
              ← Back to Events
            </a>
            <header class="mb-12 text-center md:mb-16 md:text-left">
              <span class="mb-2 inline-block text-xs font-semibold uppercase tracking-widest text-maroon">
                {workshop!.badge}
              </span>
              <div class="mb-2 flex flex-wrap justify-center gap-x-4 gap-y-1 text-sm leading-prose text-text-secondary md:justify-start">
                {isValidHtmlDateTime(workshop!.whenIso) ? (
                  <time datetime={workshop!.whenIso}>{workshop!.when}</time>
                ) : (
                  <span>{workshop!.when}</span>
                )}
                <span>{workshop!.city}</span>
              </div>
              <h1 class="font-serif text-display font-medium tracking-heading text-text-primary">
                {workshop!.title}
              </h1>
              <p class="mx-auto mt-5 max-w-reading text-left text-base leading-prose text-text-secondary md:mx-0 md:text-lg">
                {workshop!.description}
              </p>
            </header>
            <section aria-labelledby="workshop-summary-heading" class="space-y-section-gap">
              <h2
                id="workshop-summary-heading"
                class="sr-only font-serif text-content-title font-semibold tracking-heading text-text-primary"
              >
                Workshop summary
              </h2>
              <p class="max-w-reading text-left text-base leading-prose text-text-secondary md:text-lg">
                {workshop!.summary}
              </p>
            </section>
            <section
              id="gallery"
              class="mt-12 scroll-mt-24 md:mt-16"
              aria-labelledby="event-gallery-heading"
            >
              <header class="mb-8 md:mb-10">
                <h2
                  id="event-gallery-heading"
                  class="font-serif text-content-title font-semibold tracking-heading text-text-primary"
                >
                  Gallery
                </h2>
              </header>
              <EventGallery slides={[...workshop!.gallery, ...workshop!.photos]} />
            </section>
          </div>
        ) : (
          <div class="page-shell">
            <a
              href="/events"
              class="mb-6 inline-block text-sm text-text-secondary transition-colors hover:text-accent sm:mb-8"
            >
              ← Back to Events
            </a>
            <header class="mb-10 text-center sm:mb-12 md:mb-16 md:text-left">
              <span class="mb-2 inline-block text-xs font-semibold uppercase tracking-widest text-maroon">
                {upcoming!.badge}
              </span>
              <div class="mb-2 flex flex-wrap justify-center gap-x-4 gap-y-1 text-sm leading-prose text-text-secondary md:justify-start">
                {isValidHtmlDateTime(upcoming!.whenIso) ? (
                  <time datetime={upcoming!.whenIso}>{upcoming!.when}</time>
                ) : (
                  <span>{upcoming!.when}</span>
                )}
                <span>{upcoming!.city}</span>
              </div>
              <h1 class="font-serif text-display font-medium tracking-heading text-text-primary">
                {upcoming!.title}
              </h1>
              {upcoming!.subtitle ? (
                <p class="type-accent-italic mt-3 text-base text-accent sm:text-lg md:text-xl">
                  {upcoming!.subtitle}
                </p>
              ) : null}
              <p class="mx-auto mt-5 max-w-reading text-left text-base leading-prose text-text-secondary md:mx-0 md:text-lg">
                {upcoming!.description}
              </p>
            </header>
            <EventHero
              src={(upcoming!.heroImage ?? eventsCardImage).src}
              alt={(upcoming!.heroImage ?? eventsCardImage).alt}
              fit={upcoming!.heroImage ? "cover" : "contain"}
            />
            <section
              id="gallery"
              class="mt-12 scroll-mt-24 md:mt-16"
              aria-labelledby="event-gallery-heading"
            >
              <header class="mb-8 md:mb-10">
                <h2
                  id="event-gallery-heading"
                  class="font-serif text-content-title font-semibold tracking-heading text-text-primary"
                >
                  Gallery
                </h2>
              </header>
              <EventGallery
                slides={[
                  ...(upcoming!.gallery ?? []),
                  ...(upcoming!.slideshow ?? []),
                ]}
                emptyCaption="Posters, invitations, and rehearsal photos will appear here once they are added for this event."
              />
            </section>
            <div class="space-y-section-gap">
              <section aria-labelledby="event-summary-heading">
                <header class="mb-8 md:mb-10">
                  <h2
                    id="event-summary-heading"
                    class="font-serif text-content-title font-semibold tracking-heading text-text-primary"
                  >
                    {upcoming!.aboutTitle}
                  </h2>
                  <p class="mt-5 max-w-reading text-left text-base leading-prose text-text-secondary md:mt-6 md:text-lg">
                    {upcoming!.aboutBody}
                  </p>
                </header>
              </section>
              <section aria-labelledby="event-programme-heading">
                <header class="mb-8 md:mb-10">
                  <h2
                    id="event-programme-heading"
                    class="font-serif text-content-title font-semibold tracking-heading text-text-primary"
                  >
                    {upcoming!.programmeHeading ?? "Programme"}
                  </h2>
                  <p class="mt-5 max-w-reading text-left text-base leading-prose text-text-secondary md:mt-6 md:text-lg">
                    {upcoming!.programmeIntro}
                  </p>
                </header>
                <ol class="max-w-reading space-y-8">
                  {upcoming!.programmeItems.map((item, i) => (
                    <li set:key={item.title}>
                      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                        <span class="text-sm font-semibold tabular-nums text-text-secondary">
                          {i + 1}.
                        </span>
                        <h3
                          class:list={[
                            "text-base font-semibold tracking-heading text-text-primary md:text-lg",
                            item.title.includes("Shakthi")
                              ? "font-accent font-medium italic"
                              : "font-serif",
                          ]}
                        >
                          {item.title}
                        </h3>
                      </div>
                      <p class="mt-3 max-w-reading pl-0 text-left text-sm leading-prose text-text-secondary sm:pl-6 md:text-base">
                        {item.body}
                      </p>
                    </li>
                  ))}
                </ol>
              </section>
              <section aria-labelledby="event-credits-heading">
                <header class="mb-8 md:mb-10">
                  <h2
                    id="event-credits-heading"
                    class="font-serif text-content-title font-semibold tracking-heading text-text-primary"
                  >
                    {upcoming!.creditsHeading ?? "Credits"}
                  </h2>
                  <p class="mt-5 max-w-reading text-left text-base leading-prose text-text-secondary md:mt-6 md:text-lg">
                    {upcoming!.creditsIntro}
                  </p>
                </header>
                <dl class="grid max-w-reading grid-cols-1 gap-x-10 gap-y-4 sm:grid-cols-2">
                  {upcoming!.credits.map((row) => (
                    <div class="flex flex-col sm:flex-row sm:gap-4" set:key={row.label}>
                      <dt class="shrink-0 text-left text-sm font-semibold leading-prose text-text-secondary sm:w-44">
                        {row.label}
                      </dt>
                      <dd class="text-left text-sm leading-prose text-text-primary md:text-base">
                        {row.value}
                      </dd>
                    </div>
                  ))}
                </dl>
              </section>
            </div>
          </div>
        )
      }
    </main>
    <EventFooter />
  </div>
</BaseLayout>
