---
import BaseLayout from "../layouts/BaseLayout.astro";
import { AdminEventPhotosApp } from "@/components/admin/AdminEventPhotosApp";
import { Footer } from "@/components/Footer";
import { Nav } from "@/components/Nav";
import {
  getAllEventSlugs,
  getEventTitleForSlug,
} from "@/lib/event-slugs";

const pathname = Astro.url.pathname;
const slugLabels = Object.fromEntries(
  getAllEventSlugs().map((slug) => [slug, getEventTitleForSlug(slug)]),
);
---

<BaseLayout
  title="Admin — Event photo links | Ruchi Gupta"
  description="Manage public Google Drive and Cloudinary links on event pages."
  robotsNoindex
  omitClientShell
>
  <div class="relative z-10 flex min-h-screen w-full flex-col bg-background">
    <Nav client:load pathname={pathname} />
    <main class="min-w-0 flex-1">
      <div class="page-shell py-10 md:py-14">
        <a
          href="/"
          class="mb-8 inline-block text-sm text-text-secondary transition-colors hover:text-accent"
        >
          ← Home
        </a>
        <header class="mb-10 md:mb-12">
          <h1
            class="font-serif text-display font-medium tracking-heading text-text-primary"
          >
            Admin
          </h1>
          <p class="mt-3 max-w-reading text-left text-base leading-relaxed text-text-secondary">
            Control the &ldquo;More photos&rdquo; section on each event page.
            Production saves use Upstash Redis (Vercel integration); local
            <code class="rounded bg-black/[0.04] px-1 py-0.5 font-mono text-sm"
              >npm run dev</code
            >
            writes
            <code class="rounded bg-black/[0.04] px-1 py-0.5 font-mono text-sm"
              >src/data/event-photo-links.json</code
            >.
          </p>
        </header>
        <AdminEventPhotosApp client:load slugLabels={slugLabels} />
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>
