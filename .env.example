# --- Admin (/admin): event “More photos” (Google Drive + Cloudinary) ---
# Override the default password (default is ruchigupta). Set a strong value in production.
ADMIN_PASSWORD=
# Optional: HMAC secret for the admin session cookie (defaults to a hash of ADMIN_PASSWORD).
ADMIN_SESSION_SECRET=
# Optional: comma-separated hostnames allowed to POST /api/admin/login (e.g. ruchikagupta.com).
# If unset, any host can attempt login (still requires password).
ADMIN_HOST_ALLOWLIST=
# Production persistence for photo-link toggles/URLs (Vercel → Storage → Redis / Upstash).
# Create a Redis store and paste REST URL + token from the Upstash integration.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudinary (past event invites + gallery). Astro/Vite public env prefix is PUBLIC_.
# For local preview with sample assets from the demo account, use: demo
PUBLIC_CLOUDINARY_CLOUD_NAME=
# Legacy (still read by getCloudinaryCloudName if PUBLIC_ is unset):
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# WhatsApp “Contact received” (Contact page → Save). Twilio WhatsApp API sends TO +91 9999600584.
# https://console.twilio.com — enable WhatsApp on your Twilio number, then set:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Must be your Twilio WhatsApp sender, e.g. whatsapp:+14155238886 (sandbox) or whatsapp:+1xxxxxxxxxx (production)
TWILIO_WHATSAPP_FROM=
